NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/secure-enterprise-platform
SESSION_TOKEN_TTL_HOURS=12
OTP_TTL_MINUTES=10
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=30
RESET_TOKEN_TTL_MINUTES=20
ACADEMIC_MAC_SECRET=change-this-secret
DEFAULT_RSA_KEY_SIZE=32
DEFAULT_ECC_CURVE=secp256k1-demo
ENABLE_BIOMETRIC_CHALLENGE=true
OTP_DELIVERY_MODE=email
OTP_FALLBACK_TO_PREVIEW=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=security@enterprise.local
SMS_PROVIDER=console
SMS_FROM=SecureOps
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567
