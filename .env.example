NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/secure-enterprise-platform
SESSION_TOKEN_TTL_HOURS=12
OTP_TTL_MINUTES=10
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=30
RESET_TOKEN_TTL_MINUTES=20
ACADEMIC_MAC_SECRET=change-this-secret
DEFAULT_RSA_KEY_SIZE=32
DEFAULT_ECC_CURVE=secp256k1-demo
ENABLE_BIOMETRIC_CHALLENGE=true

