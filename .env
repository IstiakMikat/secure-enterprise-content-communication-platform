# Production Environment Configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/secure-enterprise-platform
SESSION_TOKEN_TTL_HOURS=12
OTP_TTL_MINUTES=10
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=30
RESET_TOKEN_TTL_MINUTES=20
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
SESSION_SECRET=change-this-session-secret-for-production
DEFAULT_RSA_KEY_SIZE=32
DEFAULT_ECC_CURVE=secp256k1-demo
ENABLE_BIOMETRIC_CHALLENGE=true

# Email Configuration - REAL EMAIL DELIVERY
OTP_DELIVERY_MODE=email
OTP_FALLBACK_TO_PREVIEW=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=security@yourcompany.com

# SMS Configuration (Optional)
SMS_PROVIDER=console
SMS_FROM=SecureOps
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567
